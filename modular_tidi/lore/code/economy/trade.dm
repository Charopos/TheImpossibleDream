/datum/merchant_catalog/rosawood
	name = "Pharovian Arsenal"
	desc = "The private arsenal of the Court of the Peaks. It produces the finest elven arms in the Midderland: fine steel weapons, bows and the bounty of Rosawood's forests." //TODO: flavor

/datum/realm_condition/etrusca_harvest_festival
	description = "A harvest festival held in honor of Astrata and Eora is underway. Abundant vegetables, cheese and limoncello are being exported. Silk and fur are in high demand for festival garments and gifts."

/datum/realm_condition/grenzelhoft_mage_purge
	description = "In the wake of another arcanist incident, the Emperor's Magi have called for a sweep of unregistered magi. There is to be a purge. Confiscated staves and magos mantles flood the markets while the court trims its silk to look less ornate. Cured leather is scarce and in high demand."

/datum/standing_order/demand_artificed_panoply
	project_by_region = list(
		TRADE_REGION_KINGSFIELD = list("the Count's master of arms", "an artificer's patron", "a champion riding in the tournament"),
		TRADE_REGION_DAFTSMARCH = list("a smith's showpiece", "a forgemaster's masterpiece", "a guild exhibition"),
		TRADE_REGION_HEARTFELT = list("the count's champion", "a knight's investiture", "a warden captain"),
	)

/datum/realm_condition/grenzelhoft_holy_pilgrimage
	description = "A grand procession from the Ten Temples winds through the inner provinces. Pilgrims demand tangerines and sugar for offerings, and Saffira for the reliquaries the clergy are gilding for the occasion."
